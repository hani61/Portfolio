{
  "name": "hanylockedin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "hanylockedin.com — static portfolio and services site for Hany (WordPress + AI revenue systems).",
  "scripts": {
    "dev": "bun run css && node scripts/serve.mjs",
    "css": "tailwindcss -i src/input.css -o assets/css/site.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o assets/css/site.css --watch",
    "images": "python3 scripts/make-images.py",
    "pdf": "python3 scripts/make-pdf.py",
    "build": "bun run css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
